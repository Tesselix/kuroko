{
	"folders": [
		{ "path": "." }
	],
	"settings": {
		"files.exclude": { ".zig-cache": true },
		"search.exclude": { ".zig-cache": true, "zig-out": true }
	},
	"extensions": {
		"recommendations": [
			"ziglang.vscode-zig",
			"vadimcn.vscode-lldb"
		]
	},

	// ---------------------------------------------------------------- tasks
	// Terminal → Run Task…, or Cmd+Shift+B for the default build.
	"tasks": {
		"version": "2.0.0",
		"problemMatcher": [],
		"tasks": [
			{
				"label": "Build",
				"detail": "zig build (ReleaseSafe) → zig-out/bin",
				"type": "shell",
				"command": "zig build",
				"group": { "kind": "build", "isDefault": true },
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Build (Debug)",
				"detail": "zig build -Doptimize=Debug → zig-out/debug/bin, for the debugger",
				"type": "shell",
				"command": "zig build -Doptimize=Debug --prefix zig-out/debug",
				"group": "build",
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Build for Ubuntu VM",
				"detail": "aarch64-linux into ubuntu-share/kuroko",
				"type": "shell",
				"command": "sh tools/ubuntu/build.sh",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "Test",
				"detail": "zig build test",
				"type": "shell",
				"command": "zig build test --summary all",
				"group": { "kind": "test", "isDefault": true },
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run Kuroko",
				"detail": "zig build run: compositor + desktop + Controls and Scroll Lab",
				"type": "shell",
				"command": "zig build run",
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run Kuroko (dark)",
				"type": "shell",
				"command": "zig build run -- --dark",
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run Kuroko (apps in the panel)",
				"type": "shell",
				"command": "zig build run -- --panel",
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run Kuroko (script)",
				"detail": "Plays one of the simulator's scripted sessions",
				"type": "shell",
				"command": "zig build run -- --script ${input:script}",
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run desktop service",
				"detail": "txdesk: prints the scene graph; reconnects until the compositor is up",
				"type": "shell",
				"command": "zig build run-desk",
				"isBackground": true,
				"presentation": { "panel": "dedicated" },
				"problemMatcher": {
					"owner": "zig",
					"fileLocation": ["autoDetect", "${workspaceFolder}"],
					"pattern": {
						"regexp": "^(.+?):(\\d+):(\\d+): (error|note): (.*)$",
						"file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
					}
				}
			},
			{
				"label": "Run Kuroko + desktop service",
				"dependsOn": ["Run Kuroko", "Run desktop service"],
				"dependsOrder": "parallel",
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				"id": "script",
				"type": "pickString",
				"description": "Scripted session (plays, then the window stays open for your input)",
				"options": ["map", "launcher", "drag", "swap", "enlarge", "minimize", "maximize", "restore_icon", "fullscreen", "panel_drag", "apps_panel", "buttons", "control_center", "chooser", "cue", "flash", "preview", "preview_restore", "close", "minimize_mid", "minimize_flash", "menu_title", "panel_buttons", "minimize_all", "new_badge", "new_window", "group", "group_menu", "pulse"],
				"default": "minimize"
			}
		]
	},

	// ------------------------------------------------------- run and debug
	// Run and Debug view (Cmd+Shift+D). F5 debugs, Ctrl+F5 runs without the
	// debugger. Needs the CodeLLDB extension (vadimcn.vscode-lldb).
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Kuroko",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/bin/txsim",
				"args": [],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build"
			},
			{
				"name": "Kuroko (dark)",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/bin/txsim",
				"args": ["--dark"],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build"
			},
			{
				"name": "Kuroko (apps in the panel)",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/bin/txsim",
				"args": ["--panel"],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build"
			},
			{
				"name": "Kuroko (script)",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/bin/txsim",
				"args": ["--script", "${input:script}"],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build"
			},
			{
				"name": "Kuroko (Debug build)",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/debug/bin/txsim",
				"args": [],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build (Debug)"
			},
			{
				"name": "Desktop service (txdesk)",
				"type": "lldb",
				"request": "launch",
				"program": "${workspaceFolder}/zig-out/bin/txdesk",
				"args": [],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "Build"
			}
		],
		"compounds": [
			{
				"name": "Kuroko + desktop service",
				"configurations": ["Kuroko", "Desktop service (txdesk)"],
				"stopAll": true
			}
		],
		"inputs": [
			{
				"id": "script",
				"type": "pickString",
				"description": "Scripted session (plays, then the window stays open for your input)",
				"options": ["map", "launcher", "drag", "swap", "enlarge", "minimize", "maximize", "restore_icon", "fullscreen", "panel_drag", "apps_panel", "buttons", "control_center", "chooser", "cue", "flash", "preview", "preview_restore", "close", "minimize_mid", "minimize_flash", "menu_title", "panel_buttons", "minimize_all", "new_badge", "new_window", "group", "group_menu", "pulse"],
				"default": "minimize"
			}
		]
	}
}
